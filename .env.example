# Flow keys from the Voxio dashboard; the browser uses them to start voice sessions.
# Which sign-in gets which agent is set in src/users.ts.
VITE_VOXIO_FLOW_KEY=vk_original_agent
VITE_FLOW_KEY_CHEMIST=vk_chemist_agent
VITE_FLOW_KEY_DOCTOR=vk_doctor_agent
VITE_FLOW_KEY_ROCHE_CALLER=vk_roche_caller_agent
VITE_FLOW_KEY_ROCHE_AGENT=vk_roche_agent
# Password for the sign-in page (shared by the accounts in src/users.ts).
VITE_LOGIN_PASSWORD=choose-a-password
